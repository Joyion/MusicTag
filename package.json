{
  "name": "nodeserver",
  "version": "1.0.0",
  "description": "",
  "main": "node.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "webpack --config webpack.prod.js",
    "testServer": "nodemon server/server.js",
    "start": "node server/server.js",
    "devserver": "webpack-dev-server --config webpack.dev.js",
    "concur": "concurrently \"npm run devserver\" \"nodemon server/server.js\"",
    "stopServer": "lsof -i tcp:9000 -t | xargs kill -9 ",
    "stopDev": "lsof -i tcp:8080 -t | xargs kill -9"
  },
  "author": "Joyion Timmons",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "babel-loader": "^10.0.0",
    "dotenv-webpack": "^8.1.0",
    "html-webpack-plugin": "^5.6.3",
    "sass": "^1.86.3",
    "sass-loader": "^16.0.5",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1",
    "webpack-merge": "^6.0.1"
  },
  "proxy": "http://localhost:5000/",
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.0"
  }
